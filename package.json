{
  "name": "administracao-loja-x",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Administração Loja X — Sistema web de gestão administrativa",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node src/scripts/init-db.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:db": "node src/scripts/dev-db.js",
    "db:init": "node src/scripts/init-db.js",
    "user:create": "node src/scripts/create-user.js",
    "user:reset": "node src/scripts/reset-password.js",
    "seed:demo": "node src/scripts/seed-demo.js",
    "seed:demo:remover": "node src/scripts/remover-demo.js",
    "verificar": "node scripts/verificar-api.mjs",
    "test": "node --test tests/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
