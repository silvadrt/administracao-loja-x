# ============================================================
# Administração Loja X — modelo de configuração
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env contém SEGREDOS e nunca deve ser compartilhado
# nem enviado para o Git (ele já está no .gitignore).
# ============================================================

# Porta do servidor local
PORT=3000

# development | production  (use production somente na hospedagem)
NODE_ENV=development

# Conexão com o banco PostgreSQL.
# Para desenvolvimento local com o PostgreSQL embutido (`npm run dev:db`):
#   DATABASE_URL=postgres://lojax:lojax-dev-123456@localhost:55433/administracao_loja_x
# Para banco na nuvem (Neon/Supabase), cole a URI com ?sslmode=verify-full:
DATABASE_URL=postgres://lojax:lojax-dev-123456@localhost:55433/administracao_loja_x

# Segredo dos tokens de sessão. Gere um aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_BYTES

# Validade do token de acesso e do token de renovação
JWT_EXPIRES_IN=30m
REFRESH_EXPIRES_IN=7d

# Deixe vazio para o sistema ser acessado pelo próprio endereço dele (recomendado).
# Só preencha se o painel rodar em um endereço separado (ex.: http://localhost:5173).
CORS_ORIGIN=

# Coloque 1 quando estiver publicado atrás de proxy/reverse-proxy
# (Render, Railway, Fly.io etc.). Em local, deixe 0.
TRUST_PROXY=0
